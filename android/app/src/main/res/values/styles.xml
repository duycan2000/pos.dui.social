<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Transparent while Chrome opens the POS, so there is no white flash. -->
    <style name="LauncherTheme" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/bar</item>
    </style>
</resources>
